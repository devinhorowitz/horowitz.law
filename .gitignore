
# Python bytecode
__pycache__/
*.py[cod]
 
# Pipeline run artifacts: written at runtime by scripts/update.py and
# scripts/backfill.py as the pull-request body, never committed.
# (CI also gates commits with an explicit add-paths list.)
scripts/pr_body.md
scripts/court_drift.md
scripts/backfill_pr_body.md
scripts/treatment_pr_body.md
scripts/queue_cases_pr_body.md
scripts/assess_precedential_pr_body.md
 
