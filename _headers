# =============================================================
# Netlify _headers file for horowitz.law
# Reference: https://docs.netlify.com/routing/headers/
#
# Goal: bring the site from a B-grade to an A-grade on
# securityheaders.com by adding modern security headers.
# =============================================================

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'inline-speculation-rules' 'sha256-GprSUo0oAooQ3fkyiEXOxOeGqNq7uHWnkt2if1JM+UQ=' 'sha256-8QD079uttdh6iO8GObIOlfAgn6UgIVVyTe+bb+Tzq3Y='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'

# -------------------------------------------------------------
# Caching. Everything is cached hard for a year. base.css and
# app.js are safe to cache this long because their <link> and
# <script> references carry a ?v= version query that is bumped
# on any deploy that changes them: a new version is a new URL,
# so the browser refetches instead of serving a stale copy.
# (Netlify _headers syntax; Cloudflare Pages reads the same
# format at cutover.)
# -------------------------------------------------------------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.vcf
  Cache-Control: public, max-age=2592000

/base.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable
