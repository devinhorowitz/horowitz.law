# horowitz.law — _headers (Cloudflare Pages)
#
# RECONSTRUCTED 2026-06-10 from the live response headers. Diff against
# the existing file before adopting; the one functional change is that
# exactly ONE rule now matches font paths, which removes the duplicated
# Cache-Control value currently emitted on /fonts/* (two of the old
# rules both matched — e.g. /fonts/* and /*.woff2 — keep one).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'inline-speculation-rules' 'sha256-+4YwaSApuertgvSbK2kOnuWVRegPjlBp3KgZFm+qObU=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Clacks-Overhead: GNU Terry Pratchett

# Versioned assets: cache-busted via ?v= (sha256[:10] of contents), so
# the files themselves are immutable for a year. One rule per family.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Service worker: keep it off the /*.js immutable rule so a redeployed
# worker is fetched promptly instead of being pinned for a year.
/sw.js
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images: 30 days (matches current live behavior).
/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000

# Feed: allow cross-origin RSS readers. (Live currently sends
# Access-Control-Allow-Origin: * globally; scoping it here is the
# optional tightening — delete this block to keep global behavior.)
/opinions.xml
  Access-Control-Allow-Origin: *

# Freshness status, read by the opinions page on each load. Always revalidate so
# the indicator reflects the latest run rather than an edge- or browser-cached copy.
/status.json
  Cache-Control: no-cache
